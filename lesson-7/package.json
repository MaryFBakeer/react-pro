{
  "name": "react-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run clean && tsx configs/esbuild.app.config.ts --mode=dev",
    "build": "npm run clean && tsc -b && npm run build:app && npm run build:lib",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../.gitignore .",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:app": "tsx configs/esbuild.app.config.ts --mode=prod",
    "build:lib": "tsx configs/esbuild.lib.config.ts",
    "build:lib:swc": "npm run build:lib:swc:esm && npm run build:lib:swc:cjs",
    "build:lib:swc:esm": "swc lib -d dist/lib-swc/esm --config-file configs/swc.esm.json --strip-leading-paths",
    "build:lib:swc:cjs": "swc lib -d dist/lib-swc/cjs --config-file configs/swc.cjs.json --strip-leading-paths && node -e \"fs.writeFileSync('dist/lib-swc/cjs/package.json',JSON.stringify({type:'commonjs'}))\""
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
